{
  "name": "dedilho-wars",
  "main": "index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "../client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dedilho-wars",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../drizzle"
    }
  ]
}