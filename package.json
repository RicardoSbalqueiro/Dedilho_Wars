{
  "name": "dedilho-wars",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm run db:local && npm run preview",
    "build": "npm run typecheck && node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "dev:client": "vite",
    "db:generate": "drizzle-kit generate",
    "db:local": "node scripts/migrate-local.mjs",
    "test": "node scripts/test.mjs",
    "balance:audit": "node scripts/balance-report.mjs docs/balance-measurements-after.json docs/balance-after.json"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "drizzle-kit": "0.31.4",
    "drizzle-orm": "0.44.5",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "wrangler": "4.50.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
